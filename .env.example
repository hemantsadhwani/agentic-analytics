# Copy to .env and fill in what you use. .env is git-ignored. Load it with:
#   set -a; source .env; set +a
# Provider: fake | anthropic | bedrock | ollama. Unset + no key = fake (offline, $0).
LLM_PROVIDER=fake
# Optional model override for the chosen provider.
LLM_MODEL=
# Anthropic direct.
ANTHROPIC_API_KEY=
# Claude on AWS Bedrock (credentials come from the standard AWS chain: profile, SSO, role).
AWS_REGION=us-east-1
# Local model (private mode).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Recorded in the audit row when you approve or reject at the gate.
REPORT_APPROVER=local-user
